# Stock Market Insights Bot - Environment Configuration

# Application Mode: set to True to run fully offline using high-quality demo data
DEMO_MODE=True

# Database Configuration
DATABASE_URL=sqlite:///./data/stock_insights.db

# LLM Provider Configuration
# Supported providers: "groq", "gemini", "openai", "rule_based"
LLM_PROVIDER=rule_based

# API Keys (leave blank or specify keys if using external providers)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Market Configuration
DEFAULT_EXCHANGE=NASDAQ
DEFAULT_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30

# News Ingestion Settings
MAX_ARTICLES_PER_FEED=25
FETCH_TIMEOUT_SECONDS=10
NEWS_CACHE_TTL_MINUTES=30

# Logging
LOG_LEVEL=INFO
